function getOrCreateSheet_(name) {
  const book = SpreadsheetApp.openById(SPREADSHEET_ID);
  return book.getSheetByName(name) || book.insertSheet(name);
}

function ensureHeaders_(sheet, headers) {
  const lastColumn = Math.max(sheet.getLastColumn(), 1);
  const existing = sheet.getLastRow() > 0 ? sheet.getRange(1, 1, 1, lastColumn).getDisplayValues()[0].map(String) : [];
  const missing = headers.filter(function(header) { return existing.indexOf(header) < 0; });
  if (missing.length) {
    const start = existing.length + 1;
    if (sheet.getMaxColumns() < start + missing.length - 1) sheet.insertColumnsAfter(sheet.getMaxColumns(), start + missing.length - 1 - sheet.getMaxColumns());
    sheet.getRange(1, start, 1, missing.length).setValues([missing]);
  }
  const finalHeaders = existing.concat(missing);
  return finalHeaders.reduce(function(map, header, index) { if (header) map[header] = index + 1; return map; }, {});
}

function writeObjectRow_(sheet, headerMap, rowNumber, values) {
  Object.keys(values).forEach(function(header) {
    if (headerMap[header]) sheet.getRange(rowNumber, headerMap[header]).setValue(values[header] == null ? '' : values[header]);
  });
}

function findRowByHeaderValue_(sheet, headerMap, header, value) {
  if (!value || !headerMap[header] || sheet.getLastRow() < 2) return 0;
  const values = sheet.getRange(2, headerMap[header], sheet.getLastRow() - 1, 1).getDisplayValues();
  const index = values.findIndex(function(row) { return String(row[0]) === String(value); });
  return index >= 0 ? index + 2 : 0;
}

function normalizeGender_(value) {
  const text = String(value || '').trim();
  return text === '男' || text === '女' || text === 'その他' ? text : '';
}

function formatDateValue_(value) {
  if (!value) return '';
  if (Object.prototype.toString.call(value) === '[object Date]' && !isNaN(value.getTime())) return Utilities.formatDate(value, 'Asia/Tokyo', 'yyyy-MM-dd');
  const text = String(value).trim().replace(/\//g, '-');
  return /^\d{4}-\d{1,2}-\d{1,2}$/.test(text) ? text.split('-').map(function(part, index) { return index === 0 ? part : String(Number(part)).padStart(2, '0'); }).join('-') : '';
}

function normalizeEnrollmentStatus_(value) {
  const text = String(value || '').trim();
  return text === '休会' ? '休会' : text === '退会' ? '退会' : '在籍';
}

function teacherStatusLabel_(status) {
  return status === 'pending' ? '承認待ち' : status === 'approved' ? '承認' : status === 'held' ? '保留' : status === 'rejected' ? '却下' : status === 'disabled' ? '利用停止' : 'ゲスト';
}

function auditActionLabel_(action) {
  const labels = {
    guest_registered: 'ゲスト登録', guest_applied: 'ゲスト申請', teacher_applied: '先生登録申請',
    teacher_approved: '先生承認', teacher_held: '先生保留', teacher_rejected: '先生却下',
    teacher_disabled: '先生利用停止', teacher_activated: '先生利用再開', admin_applied: '管理者登録申請',
    admin_registered: '管理者登録', admin_profile_updated: '管理者情報更新', admin_approve: '管理者承認',
    admin_hold: '管理者保留', admin_reject: '管理者却下', admin_disable: '管理者利用停止', admin_activate: '管理者利用再開',
    profile_change_applied: '登録情報変更申請', profile_change_approve: '変更申請承認',
    profile_change_hold: '変更申請保留', profile_change_reject: '変更申請却下', assessment_saved: '評価保存',
    app_config_updated: '設定・名簿変更', login_requirement_changed: 'ログイン必須設定変更', assessment_deleted: '評価削除'
  };
  return labels[action] || String(action || '操作');
}

function json_(value) {
  return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
}
