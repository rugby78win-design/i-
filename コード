const TEACHER_HEADERS = ['先生ID','共通先生ID','氏名','呼ばれ方','電話番号','申請区分','所属','担当クラス','その他登録情報','状態','申請日時','承認日時','承認者ID','承認者名','登録日時','更新日時'];
