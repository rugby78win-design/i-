function doGet(e) {
  if ((e.parameter.action || '') !== 'roster') return json_({ students: [] });
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(ROSTER_SHEET);
  if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < 1) return json_({ students: [] });
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0].map(String);
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  const at = function(row, names, fallback) {
    const index = names.map(function(name) { return headers.indexOf(name); }).find(function(value) { return value >= 0; });
    return index >= 0 ? row[index] : row[fallback];
  };
  const students = rows.filter(function(row) { return at(row, ['生徒ID','技テスト内部ID','会員ID','ID'], 0); }).map(function(row) {
    return {
      id: String(at(row, ['生徒ID','技テスト内部ID','会員ID','ID'], 0) || ''),
      commonMemberId: String(at(row, ['共通会員ID','共通ID'], -1) || ''),
      name: String(at(row, ['氏名','名前'], 1) || ''),
      kana: String(at(row, ['ふりがな','フリガナ'], 2) || ''),
      grade: String(at(row, ['学年'], -1) || ''),
      gender: normalizeGender_(at(row, ['性別'], -1)),
      classroomId: String(at(row, ['校舎ID','教室ID'], -1) || ''),
      classroomName: String(at(row, ['教室表示名','校舎名','教室名'], -1) || ''),
      className: String(at(row, ['クラス','クラス名'], 3) || ''),
      groupName: String(at(row, ['登録班','班'], 4) || '未設定'),
      enrollmentStatus: normalizeEnrollmentStatus_(at(row, ['在籍状態','状態'], 5)),
      updatedAt: String(at(row, ['更新日時'], -1) || ''),
      birthDate: formatDateValue_(at(row, ['生年月日'], -1)),
      age: Number(at(row, ['年齢'], -1)) || ''
    };
  });
  return json_({ students: students });
}

function doPost(e) {
  const body = JSON.parse(e.postData.contents || '{}');
  if (body.action === 'upsertTeacher' && body.teacher) return upsertTeacher_(body.teacher);
  if (body.action === 'upsertAdmin' && body.admin) return upsertAdmin_(body.admin);
  if (body.action === 'appendAudit' && body.event) return appendAudit_(body.event);
  if (body.action === 'upsertChangeRequest' && body.request) return upsertChangeRequest_(body.request);
  if (body.action === 'upsertStudent' && body.student) return upsertStudent_(body.student);
  if (body.action === 'promoteGuest' && body.student) return promoteGuest_(body.student);
  if (body.action === 'deleteAssessment' && body.recordId) return deleteAssessment_(body.recordId);
  if (body.action !== 'appendAssessments' || !Array.isArray(body.records)) return json_({ ok: false });
  const sheet = getOrCreateSheet_(RECORD_SHEET);
  const headerMap = ensureHeaders_(sheet, RECORD_HEADERS);
  body.records.forEach(function(record) {
    const recordId = String(record.recordId || record.id || '');
    const rowNumber = findRowByHeaderValue_(sheet, headerMap, '記録ID', recordId) || sheet.getLastRow() + 1;
    writeObjectRow_(sheet, headerMap, rowNumber, {
      '記録ID': recordId, '実施日': record.testDate, '生徒ID': record.studentId, '共通会員ID': record.memberId,
      '氏名': record.studentName, 'ふりがな': record.studentKana, '学年': record.grade, '性別': record.gender,
      '校舎ID': record.classroomId, '教室表示名': record.classroomName, 'クラス': record.className, '班': record.groupName,
      '種目': record.category, '技・評価項目': record.skill, '評価': record.score, '先生メモ': record.note,
      '担当先生': record.teacherName, '登録日時': record.createdAt, '更新日時': record.updatedAt,
      '技テスト内部先生ID': record.actorInternalTeacherId, '入力者先生ID': record.actorTeacherId,
      '入力者表示名': record.actorDisplayName, '入力者区分': record.actorStatus
    });
  });
  return json_({ ok: true, count: body.records.length });
}

function upsertStudent_(student) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(ROSTER_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return json_({ ok: false, error: 'student sheet not found' });
  const headerMap = ensureHeaders_(sheet, STUDENT_LINK_HEADERS);
  ensureStudentGenderValidation_(sheet, headerMap);
  const idHeader = ['生徒ID','技テスト内部ID','会員ID','ID'].find(function(header) { return Boolean(headerMap[header]); });
  if (!idHeader) return json_({ ok: false, error: 'student id header not found' });
  const rowNumber = findRowByHeaderValue_(sheet, headerMap, idHeader, student.studentId);
  if (!rowNumber) return json_({ ok: true, updated: false });
  writeObjectRow_(sheet, headerMap, rowNumber, {
    '共通会員ID': student.commonMemberId, '学年': student.grade, '性別': student.gender,
    '校舎ID': student.classroomId, '教室表示名': student.classroomName,
    '在籍状態': student.enrollmentStatus, '更新日時': student.updatedAt
  });
  return json_({ ok: true, updated: true, row: rowNumber });
}

/**
 * 明示的な初期設定用。読み取り処理からは呼ばず、既存列を維持したまま
 * 不足している「性別」列だけを末尾へ追加し、男・女・その他の選択規則を設定する。
 */
function setupStudentRosterSchema() {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(ROSTER_SHEET);
  if (!sheet) throw new Error('生徒マスタが見つかりません');
  const headerMap = ensureHeaders_(sheet, ['性別', '生年月日']);
  ensureStudentGenderValidation_(sheet, headerMap);
  return { ok: true, sheet: ROSTER_SHEET, genderColumn: headerMap['性別'] };
}

function promoteGuest_(student) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(ROSTER_SHEET);
  if (!sheet) return json_({ ok: false, error: 'student sheet not found' });
  const headerMap = ensureHeaders_(sheet, ['性別', '共通会員ID', '生年月日']);
  ensureStudentGenderValidation_(sheet, headerMap);
  const marker = 'ゲスト移行元:' + String(student.id || '');
  const existingByMarker = findRowByHeaderValue_(sheet, headerMap, '備考', marker);
  if (existingByMarker) return json_({ ok: true, duplicate: true, row: existingByMarker });
  const ids = headerMap['共通会員ID'] && sheet.getLastRow() >= 2 ? sheet.getRange(2, headerMap['共通会員ID'], sheet.getLastRow() - 1, 1).getDisplayValues() : [];
  const maxId = ids.reduce(function(max, row) { const match = String(row[0] || '').match(/^iC(\d{3})$/); return match ? Math.max(max, Number(match[1])) : max; }, 0);
  if (maxId >= 999) return json_({ ok: false, error: 'common id limit' });
  const commonId = 'iC' + String(maxId + 1).padStart(3, '0');
  const internalId = 'G-' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd') + '-' + String(maxId + 1).padStart(3, '0');
  const rowNumber = sheet.getLastRow() + 1;
  writeObjectRow_(sheet, headerMap, rowNumber, {
    '生徒ID': internalId, '共通会員ID': commonId, '氏名': String(student.name || ''), 'ふりがな': String(student.kana || ''),
    'クラス': String(student.className || ''), '班': '', '在籍状態': '在籍', '登録日': new Date(), '備考': marker,
    '性別': normalizeGender_(student.gender), '生年月日': String(student.birthDate || '')
  });
  return json_({ ok: true, row: rowNumber, commonMemberId: commonId, studentId: internalId });
}

function ensureStudentGenderValidation_(sheet, headerMap) {
  const column = headerMap['性別'];
  if (!column) return;
  const rowCount = Math.max(sheet.getMaxRows() - 1, 1);
  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInList(['男', '女', 'その他'], true)
    .setAllowInvalid(false)
    .setHelpText('男・女・その他から選択してください')
    .build();
  sheet.getRange(2, column, rowCount, 1).setDataValidation(rule);
}

function deleteAssessment_(recordId) {
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(RECORD_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return json_({ ok: true, deleted: false });
  const headerMap = ensureHeaders_(sheet, RECORD_HEADERS);
  const rowNumber = findRowByHeaderValue_(sheet, headerMap, '記録ID', recordId);
  if (rowNumber) sheet.deleteRow(rowNumber);
  return json_({ ok: true, deleted: Boolean(rowNumber) });
}

